rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprint: Project
    function isValidProject(data) {
      return data.keys().hasAll(['name', 'ownerId', 'createdAt'])
        && data.keys().size() == 4 // name, ownerId, createdAt, description (optional but usually present)
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.ownerId == request.auth.uid
        && data.createdAt == request.time;
    }

    // Validation Blueprint: TestCase
    function isValidTestCase(data) {
      return data.keys().hasAll(['projectId', 'title', 'flow', 'authorId', 'createdAt'])
        && data.projectId is string && isValidId(data.projectId)
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.flow is string && data.flow.size() <= 1000
        && data.authorId == request.auth.uid
        && data.createdAt == request.time
        && (!data.keys().contains('steps') || (data.steps is list && data.steps.size() <= 50));
    }

    // Validation Blueprint: Document
    function isValidDocument(data, isCreate) {
      return data.keys().hasAll(['projectId', 'name', 'content', 'ownerId', 'createdAt', 'category'])
        && data.projectId is string && isValidId(data.projectId)
        && data.name is string && data.name.size() > 0 && data.name.size() <= 255
        && data.content is string && data.content.size() <= 100000 
        && data.category in ['api', 'functional', 'technical', 'general']
        && data.ownerId == request.auth.uid
        && (isCreate ? data.createdAt == request.time : data.createdAt == resource.data.createdAt)
        && (!data.keys().contains('rawContent') || (data.rawContent is string && data.rawContent.size() <= 100000));
    }

    // 1. The Master Gate: Projects
    match /projects/{projectId} {
      allow get: if isSignedIn() && isOwner(existing().ownerId);
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidProject(incoming());
      allow update: if isSignedIn() && isOwner(existing().ownerId) && isValidProject(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description']);
      allow delete: if isSignedIn() && isOwner(existing().ownerId);

      // Sub-collections: Nested under Project
      match /testcases/{testcaseId} {
        allow get: if isSignedIn() && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
        allow list: if isSignedIn() && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
        allow create: if isSignedIn() && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid && isValidTestCase(incoming());
        allow update: if isSignedIn() && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid && isValidTestCase(incoming())
          && (
            // Action: Edit Metadata
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'flow', 'steps', 'expectedResult', 'status', 'updatedAt'])
            && incoming().updatedAt == request.time
          );
        allow delete: if isSignedIn() && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
      }

      match /documents/{docId} {
        allow get: if isSignedIn() && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
        allow list: if isSignedIn() && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
        allow create: if isSignedIn() && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid && isValidDocument(incoming(), true);
        allow update: if isSignedIn() && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid 
          && isValidDocument(incoming(), false)
          && incoming().diff(existing()).affectedKeys().hasOnly(['content', 'name', 'updatedAt', 'rawContent', 'category'])
          && (!incoming().keys().contains('updatedAt') || incoming().updatedAt == request.time);
        allow delete: if isSignedIn() && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
      }
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isOwner(userId) && incoming().createdAt == request.time;
    }
  }
}
